{
  "name": "proton-variants",
  "version": "0.6.4",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#data/*": "./src/data/*"
  },
  "scripts": {
    "build": "vite build",
    "bump": "cog bump --auto",
    "check": "biome check . && svelte-check --tsconfig ./tsconfig.json",
    "check-releases": "bun run scripts/check-releases.ts",
    "clean": "rm -rf .context node_modules .vitest bun.lock",
    "dev": "vite dev",
    "format": "biome format --write .",
    "prepare": "svelte-kit sync",
    "preview": "vite preview",
    "scrape": "bun run scripts/scrape.ts",
    "update": "bun update --latest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "lefthook": "^2.2.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "overrides": {
    "typescript": "6.0.3"
  }
}
